<phone:PhoneApplicationPage
    x:Class="MetroGopher.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:phone="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone"
    xmlns:shell="clr-namespace:Microsoft.Phone.Shell;assembly=Microsoft.Phone"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    FontFamily="{StaticResource PhoneFontFamilyNormal}"
    FontSize="{StaticResource PhoneFontSizeNormal}"
    Foreground="{StaticResource PhoneForegroundBrush}"
    SupportedOrientations="Portrait" Orientation="Portrait"
    shell:SystemTray.IsVisible="True">

    <Grid x:Name="LayoutRoot" Background="Transparent">
        <!-- Индикатор загрузки -->
        <ProgressBar x:Name="LoadingBar" 
                     IsIndeterminate="True" 
                     Visibility="Collapsed" 
                     VerticalAlignment="Top" 
                     Margin="0,-10,0,0"/>

        <phone:Pivot x:Name="MainPivot" Title="METROGOPHER">

            <!-- Вкладка 1: Gophermap / Список -->
            <phone:PivotItem Header="{Binding Path=LocalizedResources.PivotMap, Source={StaticResource LocalizedStrings}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Единый блок адресной строки -->
                    <Grid Grid.Row="0" Margin="12,0,12,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Поле ввода: убираем фиксированную высоту и восстанавливаем дефолтный Padding -->
                        <TextBox x:Name="AddressBox" 
             InputScope="Url" 
             Margin="-12,0,0,0"
             VerticalAlignment="Center"/>

                        <!-- Кнопка перехода: ровняем строго по высоте TextBox -->
                        <Button Grid.Column="1" 
            Click="OnGoClick" 
            Width="72"
            Margin="-14,0,-12,0"
            Padding="0"
            VerticalAlignment="Stretch"
            HorizontalAlignment="Center">

                            <!-- Иконка стрелки -->
                            <TextBlock Text="&#xE101;" 
                   FontFamily="Segoe UI Symbol" 
                   FontSize="26" 
                   HorizontalAlignment="Center" 
                   VerticalAlignment="Center"/>
                        </Button>
                    </Grid>

                    <!-- Список Gophermap -->
                    <ListBox x:Name="GopherList" 
                             Grid.Row="1" 
                             SelectionChanged="OnItemSelected"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,6,0,6" HorizontalAlignment="Stretch">
                                    <Grid HorizontalAlignment="Stretch">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Иконка типа элемента -->
                                        <TextBlock Grid.Column="0" 
                                                   Text="{Binding Symbol}" 
                                                   FontFamily="Segoe UI Symbol" 
                                                   FontSize="24" 
                                                   Foreground="{StaticResource PhoneAccentBrush}" 
                                                   Margin="0,0,10,0" 
                                                   VerticalAlignment="Top"/>

                                        <!-- Текст / Ссылка -->
                                        <TextBlock Grid.Column="1" 
                                                   Text="{Binding Title}" 
                                                   FontSize="20" 
                                                   TextWrapping="Wrap" 
                                                   HorizontalAlignment="Stretch"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </phone:PivotItem>

            <!-- Вкладка 2: Просмотр текста -->
            <phone:PivotItem Header="{Binding Path=LocalizedResources.PivotDocument, Source={StaticResource LocalizedStrings}}" x:Name="PivotDocument">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="TxtDocumentContent" 
                               FontFamily="Courier New" 
                               FontSize="18" 
                               TextWrapping="Wrap" 
                               Margin="10"/>
                </ScrollViewer>
            </phone:PivotItem>

        </phone:Pivot>
    </Grid>

    <phone:PhoneApplicationPage.ApplicationBar>
        <shell:ApplicationBar IsVisible="True" IsMenuEnabled="True">
            <shell:ApplicationBar.MenuItems>
                <shell:ApplicationBarMenuItem Text="English" Click="OnToggleLanguageClick" />
            </shell:ApplicationBar.MenuItems>
        </shell:ApplicationBar>
    </phone:PhoneApplicationPage.ApplicationBar>
</phone:PhoneApplicationPage>